# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_VISION_MODEL=gpt-5-mini
# Fondo visual opcional para Bloque 12. Modelo actual recomendado en este proyecto:
OPENAI_IMAGE_MODEL=gpt-image-2.5-flare

# Meta / Facebook - selector multipágina
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v26.0
# Meta OAuth (server-only)
META_OAUTH_REDIRECT_URI=https://efimero-wheat.vercel.app/api/auth/meta/callback
META_TOKEN_ENCRYPTION_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Opcional: Insights. Si queda vacía, Analytics usa engagement.
META_POST_REACH_METRIC=

# Compliance Meta interno
META_POLICY_RULESET_VERSION=2026-09

# Token manual legacy (opcional sólo durante la migración)
# META_USER_ACCESS_TOKEN=

# Alternativa de una sola página (no es necesaria en modo multipágina)
# META_PAGE_ID=
# META_PAGE_NAME=
# META_PAGE_ACCESS_TOKEN=

# Login privado (server-only, NO uses NEXT_PUBLIC_)
# Puedes poner varios correos separados por coma.
AUTH_ALLOWED_EMAILS=tu-correo@ejemplo.com

# Bloques 21–24
# Se usa para proteger endpoints que pueden ser invocados por Vercel Cron.
CRON_SECRET=
# Dataset editorial semántico (1536 dimensiones)
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# V1.2 · Radar externo con Bright Data (server-only)
# Nunca uses NEXT_PUBLIC_ para esta clave.
BRIGHTDATA_API_KEY=
# Dataset mostrado en Bright Data: Facebook - Pages Posts by Profile URL
BRIGHTDATA_FACEBOOK_POSTS_DATASET_ID=gd_lkaxegm826bjpoo9m5

# V1.6.2 · Cheaper Inference (server-only)
# API compatible con OpenAI Chat Completions.
# El proveedor de las capturas del proyecto usa el dominio cheaperinference.com.
CHEAPERINFERENCE_API_KEY=
CHEAPERINFERENCE_MODEL=gpt-5.6-terra
CHEAPERINFERENCE_BASE_URL=https://api.cheaperinference.com/v1
# Compatibilidad: Efímero también acepta los nombres legacy CHEAPESTINFERENCE_* y CHEAPINFERENCE_*.
# ALLOW_LOCAL_GENERATION_FALLBACK=false

# Fondos gratuitos para la plantilla "Oración con fondo".
# Pixabay (clave gratis en https://pixabay.com/api/docs/). Pexels se usa solo si no hay clave de Pixabay.
PIXABAY_API_KEY=
PEXELS_API_KEY=

# Anuncios de Me gusta: tope de presupuesto DIARIO por campaña, en la moneda de la cuenta publicitaria.
ADS_MAX_DAILY_BUDGET=200

# Reels de transformación con IA (fal.ai). La clave se crea en https://fal.ai/dashboard/keys
FAL_KEY=
# Opcionales: modelo de video (imagen inicial y final), modelo de edición de imagen y precio por segundo para el estimado.
FAL_VIDEO_MODEL=fal-ai/kling-video/v3/pro/image-to-video
FAL_IMAGE_EDIT_MODEL=fal-ai/flux-pro/kontext
FAL_VIDEO_PRICE_PER_SECOND=0.112
